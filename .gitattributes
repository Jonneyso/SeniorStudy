# 统一行尾：所有文本文件使用 LF（避免 Windows CRLF 警告）
* text=auto eol=lf

# 显式声明文本文件
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf

# 二进制文件不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
